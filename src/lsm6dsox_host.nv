// lsm6dsox_host — the host side of the `.ucf` reader: the list of register
// writes of a configuration file, for a program on a computer.
//
// A device program reads the text where it lies (`lsm6dsox_ucf`).  A program
// on a computer reads a `.ucf` file and wants the list: to look at it, to
// check it against another, or to write it out as source for a device.  The
// list holds one integer for each write, `(address << 8) | value`, in the
// order of the file.  This module builds a list, so it is checked at the
// `app` tier and the rest of the package is checked at `embedded`.

use lsm6dsox_ucf

// The register writes of `text`, in order, each as `(address << 8) | value`;
// `None` when a line is none of the three kinds the reader knows (blank,
// comment, entry), in which case `ucf_error_line` says which.
pub @tier(app)
fn ucf_parse(text: Str) -> ?[Int]
    var out: [Int] = []
    var pos = 0
    var good = true
    for _i in 0..str.len(text) + 1
        let e = lsm6dsox_ucf.ucf_next(text, var pos)
        if e == lsm6dsox_ucf.UCF_END
            break
        if e == lsm6dsox_ucf.UCF_BAD
            good = false
            break
        list.push(out, e)
    if good
        return Some(out)
    None

// The line number, from 1, of the first line of `text` that is none of the
// three kinds, or 0 when there is none.
pub @tier(app)
fn ucf_error_line(text: Str) -> Int
    var pos = 0
    var line = 0
    for _i in 0..str.len(text) + 1
        let e = lsm6dsox_ucf.ucf_next(text, var pos)
        if e == lsm6dsox_ucf.UCF_END
            break
        if e == lsm6dsox_ucf.UCF_BAD
            line = lsm6dsox_ucf.ucf_line_of(text, pos)
            break
    line

// The register writes of `text` as the lines of a `.ucf` file: `Ac`, the
// address and the value in upper-case hexadecimal.  Reading the text back
// gives the list it came from.
pub @tier(app)
fn ucf_text(writes: [Int]) -> Str
    let hex = "0123456789ABCDEF"
    var out = ""
    for w in writes
        let a = (w >> 8) & 0xFF
        let d = w & 0xFF
        out = out + "Ac " + str.slice(hex, a >> 4, (a >> 4) + 1) + str.slice(hex, a & 15, (a & 15) + 1) + " " + str.slice(hex, d >> 4, (d >> 4) + 1) + str.slice(hex, d & 15, (d & 15) + 1) + "\n"
    out
