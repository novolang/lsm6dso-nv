    fn set_gyro_rate_mhz(self, mhz: Int) -> Int [hw]
        gyro_rate_write(self, mhz)

    // The gyroscope at ±125 dps.
    fn gyro_set_125dps(self) -> Bool [hw]
        gyro_range_write_125(self)

    // The power modes of the two sensors.
