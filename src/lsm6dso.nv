        int1_route(self, mask)

    fn route_int2(self, mask: Int) -> Bool [hw]
        int2_route(self, mask)

    fn configure_pins(self, active_low: Bool, open_drain: Bool) -> Bool [hw]
        int_pins_config(self, active_low, open_drain)

    // The FIFO: on, off, and the gyroscope's words and the accelerometer's.
