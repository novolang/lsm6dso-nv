// lsm6dso — ST's LSM6DSO six-axis inertial module, on its I2C or its SPI
// bus, as devices-nv's `Accelerometer`, `Gyroscope`, `Imu`, `Thermometer`
// and `Identifiable`.
//
// The facts below are from ST's data sheet "LSM6DSO: iNEMO inertial module:
// always-on 3D accelerometer and 3D gyroscope", DS12140 Rev 3, June 2024
// (its tables are named by number).  Where the sheet and the drivers read
// for this one disagree, the site says which was taken.
//
// The register map (§ 9), as this driver uses it:
//
//   0x01  FUNC_CFG_ACCESS  FUNC_CFG_ACCESS (7), SHUB_REG_ACCESS (6)
//   0x07  FIFO_CTRL1       WTM[7:0]
//   0x08  FIFO_CTRL2       STOP_ON_WTM (7), ..., WTM8 (0)
//   0x09  FIFO_CTRL3       BDR_GY (7:4), BDR_XL (3:0)
//   0x0A  FIFO_CTRL4       ..., FIFO_MODE (2:0)
//   0x0D  INT1_CTRL        ..., INT1_FIFO_FULL (5), INT1_FIFO_OVR (4),
//                          INT1_FIFO_TH (3), INT1_BOOT (2),
//                          INT1_DRDY_G (1), INT1_DRDY_XL (0)
//   0x0E  INT2_CTRL        ..., INT2_FIFO_TH (3), INT2_DRDY_TEMP (2),
//                          INT2_DRDY_G (1), INT2_DRDY_XL (0)
//   0x0F  WHO_AM_I         0x6C
//   0x10  CTRL1_XL         ODR_XL (7:4), FS_XL (3:2), LPF2_XL_EN (1)
//   0x11  CTRL2_G          ODR_G (7:4), FS_G (3:2), FS_125 (1)
//   0x12  CTRL3_C          BOOT (7), BDU (6), H_LACTIVE (5), PP_OD (4),
//                          SIM (3), IF_INC (2), SW_RESET (0)
//   0x13  CTRL4_C          SLEEP_G (6), INT2_on_INT1 (5), DRDY_MASK (3),
//                          I2C_disable (2), LPF1_SEL_G (1)
//   0x14  CTRL5_C          XL_ULP_EN (7), ROUNDING (6:5), ST_G (3:2),
//                          ST_XL (1:0)
//   0x15  CTRL6_C          ..., XL_HM_MODE (4), USR_OFF_W (3), FTYPE (2:0)
//   0x16  CTRL7_G          G_HM_MODE (7), HP_EN_G (6), HPM_G (5:4)
//   0x17  CTRL8_XL         ..., XL_FS_MODE (1)
//   0x18  CTRL9_XL         DEN bits (7:2), I3C_disable (1)
//   0x1E  STATUS_REG       TDA (2), GDA (1), XLDA (0)
//   0x20  OUT_TEMP_L, 0x21 OUT_TEMP_H
//   0x22  OUTX_L_G to 0x27 OUTZ_H_G, then 0x28 OUTX_L_A to 0x2D OUTZ_H_A:
//         each axis a 16-bit two's complement count, low byte first
//   0x3A  FIFO_STATUS1     DIFF_FIFO[7:0]
//   0x3B  FIFO_STATUS2     FIFO_WTM_IA (7), FIFO_OVR_IA (6),
//                          FIFO_FULL_IA (5), ..., DIFF_FIFO[9:8]
//   0x78  FIFO_DATA_OUT_TAG, 0x79 to 0x7E the six data bytes of a word
//
// The step.  The count is 16 bits for the full scale, so the sensitivity
// is not the full scale over 2^15: Table 2 gives 0.061, 0.122, 0.244 and
// 0.488 mg per count for ±2, ±4, ±8 and ±16 g, and 4.375, 8.75, 17.5, 35
// and 70 mdps per count for ±125, ±250, ±500, ±1000 and ±2000 dps.  The
// driver converts in integer micro-units: 61, 122, 244 and 488 ug and
// 4375, 8750, 17500, 35000 and 70000 udps per count.
//
// The full scale code.  With XL_FS_MODE clear, which it is after a reset
// and which the driver keeps, FS_XL 00, 01, 10 and 11 are ±2, ±16, ±4 and
// ±8 g (Table 45): the order is not ascending.
//
// The output data rate (Tables 44 and 48).  Codes 0001 to 1010 are 12.5,
// 26, 52, 104, 208, 416, 833, 1666, 3332 and 6664 Hz (Table 2 prints the
// last four so; the tables of §§ 9.12 and 9.13 round them to 1.66, 3.33
// and 6.66 kHz); 0000 is power-down.  The accelerometer's code 1011 is
// 1.6 Hz with XL_HM_MODE set and 12.5 Hz with it clear; the gyroscope has
// no code 1011.  The high-performance mode of each sensor is on after a
// reset; XL_HM_MODE and G_HM_MODE select low-power mode (12.5, 26 and 52
// Hz, and 1.6 Hz for the accelerometer) and normal mode (104 and 208 Hz).
// Above that the sensor is in high-performance mode whatever the bit says.
//
// The two buses.  On I2C the part answers at 0x6A (SDO/SA0 low) or 0x6B
// (high).  On SPI a transaction is a control byte, then data, inside one
// chip-select window: bit 7 is R/W (1 reads), bits 6 to 0 the register.
// The register address advances after each byte of a multiple-byte
// transfer on both buses only while IF_INC (CTRL3_C bit 2) is set; with it
// clear every byte repeats the first register (§ 5.1.2).  IF_INC is set
// after a reset, and `start` sets it again.  The part takes SPI mode 0 or
// 3.  The SDA and SCL lines are shared with I3C, whose address assignment
// can be mistaken for I2C traffic; I3C_disable in CTRL9_XL turns the I3C
// block off (§ 5.3, Table 67), and the INT1 pin must be low or open at
// power-up (§ 7).
//
// Drivers read for their fixes, nothing ported: ST's `lsm6dso_reg`
// platform-independent driver and its examples, Zephyr's
// `drivers/sensor/st/lsm6dso`, and the Linux kernel's `st_lsm6dsx`.  Each
// fix kept is named at its site.
//
// The driver holds no state: the full scales are read from the part in the
// transaction before the sample.
//
// A bus enters through `Lsm6dsoPort`, which a type that holds a bus
// implements: `Lsm6dso` for an I2C bus and `Lsm6dsoSpi` for an SPI bus.
// The framing of each bus is the generic functions `i2c_read_into`,
// `i2c_write`, `spi_read_into` and `spi_write`, so a test runs them over
// a double of the bus.

use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, I2cBus, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_accel.{ AccelMilliG, AccelRange, Accelerometer }
use dev_gyro.{ GyroMilliDps, GyroRange, Gyroscope }
use dev_imu.{ ImuSample, Imu }
use dev_thermo.{ TempMilliC, Thermometer }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let FUNC_CFG_ACCESS = 0x01
let FIFO_CTRL1 = 0x07
let FIFO_CTRL2 = 0x08
let FIFO_CTRL3 = 0x09
let FIFO_CTRL4 = 0x0A
let INT1_CTRL = 0x0D
let INT2_CTRL = 0x0E
let WHO_AM_I = 0x0F
let CTRL1_XL = 0x10
let CTRL2_G = 0x11
let CTRL3_C = 0x12
let CTRL4_C = 0x13
let CTRL5_C = 0x14
let CTRL6_C = 0x15
let CTRL7_G = 0x16
let CTRL8_XL = 0x17
let CTRL9_XL = 0x18
let STATUS_REG = 0x1E
let OUT_TEMP_L = 0x20
let OUTX_L_G = 0x22
let OUTX_L_A = 0x28
let FIFO_STATUS1 = 0x3A
let FIFO_DATA_OUT_TAG = 0x78

// WHO_AM_I's value.
let ID_LSM6DSO = 0x6C

// The SPI control byte's R/W bit.
let SPI_READ = 0x80

// CTRL3_C: block data update, the interrupt pins' polarity and output
// type, the register address increment, and the software reset.
let C3_BDU = 0x40
let C3_H_LACTIVE = 0x20
let C3_PP_OD = 0x10
let C3_IF_INC = 0x04
let C3_SW_RESET = 0x01
// CTRL4_C: data-ready masked until the filters settle, and the I2C block
// off.
let C4_DRDY_MASK = 0x08
let C4_I2C_DISABLE = 0x04
// CTRL5_C: the self-test fields.
let C5_ST_XL_MASK = 0x03
let C5_ST_G_MASK = 0x0C
let C5_ST_XL_POS = 0x01
let C5_ST_XL_NEG = 0x02
let C5_ST_G_POS = 0x04
let C5_ST_G_NEG = 0x0C
// CTRL6_C and CTRL7_G: the bits that leave high-performance mode.
let C6_XL_HM_MODE = 0x10
let C7_G_HM_MODE = 0x80
// CTRL8_XL: the full-scale mode, kept clear.
let C8_XL_FS_MODE = 0x02
// CTRL9_XL: the I3C block off.
let C9_I3C_DISABLE = 0x02
// CTRL1_XL and CTRL2_G: the full-scale field, the gyroscope's 125 dps bit.
let FS_MASK = 0x0C
let FS_125 = 0x02
// STATUS_REG: the new-data flags.
let ST_XLDA = 0x01
let ST_GDA = 0x02
// FIFO_CTRL4: bypass and continuous mode.
let FIFO_BYPASS = 0x00
let FIFO_CONTINUOUS = 0x06
// FIFO tags: the gyroscope and the accelerometer, uncompressed.
let TAG_GYRO = 1
let TAG_ACCEL = 2
// The words the FIFO holds, and the most the watermark takes.
let FIFO_DEPTH_WORDS = 512
let FIFO_WTM_MAX = 511
// The most samples the driver moves out of the FIFO into one list.
let LIST_DEPTH = 32

// The temperature sensor: 256 counts per degree, 0 at 25 °C (Table 4).
let TEMP_COUNTS_PER_C = 256
let TEMP_ZERO_MC = 25000

// The ODR codes `start` sets, 104 Hz for both sensors.
let ODR_104 = 4

// The clocks `setup` asks for: I2C fast mode, and SPI at 4 MHz in mode 3.
let I2C_HZ = 400000
let SPI_HZ = 4000000
let SPI_MODE = 3

// The most polls of the software-reset bit `start` makes, and of a
// data-ready flag a self-test makes for one sample.
let RESET_POLLS = 2000
let SELF_TEST_POLLS = 4000

// The self-test procedure of ST's `lsm6dso_self_test` example: the
// accelerometer at 52 Hz and ±4 g, the gyroscope at 208 Hz and ±2000 dps;
// the samples that pass while the output settles (100 ms), and the samples
// averaged.
let XL_ST_CTRL1 = 0x38
let G_ST_CTRL2 = 0x5C
let XL_ST_SETTLE = 6
let G_ST_SETTLE = 21
let ST_AVERAGE = 5

// INT1_CTRL and INT2_CTRL's bits for `int_route`.

// The accelerometer's data-ready flag on INT1.
pub const INT1_DRDY_XL = 0x01

// The gyroscope's data-ready flag on INT1.
pub const INT1_DRDY_G = 0x02

// The FIFO watermark on INT1.
pub const INT1_FIFO_TH = 0x08

// The FIFO overrun flag on INT1.
pub const INT1_FIFO_OVR = 0x10

// The FIFO-full flag on INT1.
pub const INT1_FIFO_FULL = 0x20

// The accelerometer's data-ready flag on INT2.
pub const INT2_DRDY_XL = 0x01

// The gyroscope's data-ready flag on INT2.
pub const INT2_DRDY_G = 0x02

// The temperature's data-ready flag on INT2.
pub const INT2_DRDY_TEMP = 0x04

// The FIFO watermark on INT2.
pub const INT2_FIFO_TH = 0x08

// The power mode of a sensor: high performance at every rate, or the
// low-power and normal modes the part has up to 208 Hz.
pub @value
enum Lsm6dsoMode
    Lsm6dsoHighPerf
    Lsm6dsoLowPower

// A bus the part is on.  `setup` makes the bus and the pins ready and
// answers whether the wiring suits the bus; `read_regs` reads `n`
// registers from `reg` in one transaction; `write_reg` writes one
// register; `irq_level` answers the level of the INT1 pin; `on_spi`
// answers whether the bus is SPI, which turns the I2C block off.
pub trait Lsm6dsoPort
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn irq_level(self) -> Int [hw]
    fn on_spi(self) -> Bool [hw]

// ── The two buses ────────────────────────────────────────────────────

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a
// write of the register and a repeated start: whether the part answered.
// The address advances while IF_INC is set.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the
// part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Reads `n` registers from `reg` into `dst` in one SPI transaction: the
// control byte with R/W set, then the data, which the part shifts out with
// no dummy byte in between.  Whether it ran, which is whether the wiring
// has a chip select.
pub fn spi_read_into<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                            n: Int, var dst: DevBytes) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((SPI_READ | (reg & 0x7F)) as u8)
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, n, var dst)

// Writes `v` to the register `reg` in one SPI transaction, R/W clear:
// whether it ran.  The part answers nothing to a write.
pub fn spi_write<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                        v: Int) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((reg & 0x7F) as u8)
    let _ = tx.push((v & 0xFF) as u8)
    var none: DevBytes = Vec.new()
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, 0, var none)

// Makes an I2C bus ready: the INT1 pin an input, the bus at 400 kHz.
// Answers whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(I2C_HZ)
    w.addr != None

// Makes an SPI bus ready: chip select driven high first, so the pin
// never drives low and the part stays on the bus it was reset on, then
// an output; the INT1 pin an input; the bus at 4 MHz in mode 3.  Answers
// whether the wiring has a chip select.
pub fn spi_setup<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    let Some(cs) = w.cs else return false
    gpio.set(cs, 1)
    gpio.mode(cs, 1)
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(SPI_HZ, SPI_MODE)
    true

// The level of the part's INT1 line on the board, 1 or 0, or -1 for a
// wiring with no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub fn reg_read<P: Lsm6dsoPort>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// Writes `v` to the register `reg` and reads it back: whether the part
// holds the value.  A register with a bit that clears itself is written
// with `write_reg`.
pub fn reg_write<P: Lsm6dsoPort>(p: P, reg: Int, v: Int) -> Bool [hw]
    if not p.write_reg(reg, v)
        return false
    reg_read(p, reg) == Some(v & 0xFF)

// Sets the bits of `mask` in `reg` to the bits of `v`, leaving the others:
// whether the part took it.
//
// Fix kept: ST's driver reads, changes and writes each field, and several
// registers hold bits that "must be set to 1" or "to 0" for correct
// operation or that the part resets to 1 (CTRL9_XL's DEN bits reset to
// 1), so a whole-register write would change what it should not.
pub fn reg_update<P: Lsm6dsoPort>(p: P, reg: Int, mask: Int, v: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    reg_write(p, reg, (old & (0xFF ^ mask)) | (v & mask))

// ── Identity ─────────────────────────────────────────────────────────

// WHO_AM_I as a `DeviceId`, or `None` when no part answers: the byte reads
// 0xFF on an SPI bus no part drives and 0x00 on one held low.
pub fn id_read<P: Lsm6dsoPort>(p: P) -> ?DeviceId [hw]
    let who = reg_read(p, WHO_AM_I) ?? 0xFF
    if who == 0xFF or who == 0
        return None
    Some(DeviceId { who: who, rev: None })

// ── Ranges and steps ─────────────────────────────────────────────────

// The accelerometer range a CTRL1_XL byte selects (Table 45, XL_FS_MODE
// clear): 00 ±2 g, 01 ±16 g, 10 ±4 g, 11 ±8 g.
pub fn accel_range_of(ctrl1: Int) -> AccelRange
    match (ctrl1 >> 2) & 3
        0 => AccelRange2g
        1 => AccelRange16g
        2 => AccelRange4g
        _ => AccelRange8g

// The FS_XL code for a range.
pub fn accel_fs_of(r: AccelRange) -> Int
    match r
        AccelRange2g  => 0
        AccelRange16g => 1
        AccelRange4g  => 2
        AccelRange8g  => 3

// The gyroscope range a CTRL2_G byte selects: 00 ±250, 01 ±500, 10 ±1000,
// 11 ±2000 dps.  With FS_125 set the range is ±125 dps, which `GyroRange`
// has no value for; the narrowest value that holds it, ±250 dps, is
// answered.
pub fn gyro_range_of(ctrl2: Int) -> GyroRange
    match (ctrl2 >> 2) & 3
        0 => GyroRange250dps
        1 => GyroRange500dps
        2 => GyroRange1000dps
        _ => GyroRange2000dps

// The FS_G code for a range.
pub fn gyro_fs_of(r: GyroRange) -> Int
    match r
        GyroRange250dps  => 0
        GyroRange500dps  => 1
        GyroRange1000dps => 2
        GyroRange2000dps => 3

// The accelerometer step in micro-g per count (Table 2).
pub fn ug_per_count(ctrl1: Int) -> Int
    match accel_range_of(ctrl1)
        AccelRange2g  => 61
        AccelRange4g  => 122
        AccelRange8g  => 244
        AccelRange16g => 488

// The gyroscope step in micro-degrees per second per count (Table 2),
// 4375 for ±125 dps.
pub fn udps_per_count(ctrl2: Int) -> Int
    if (ctrl2 & FS_125) != 0
        return 4375
    match gyro_range_of(ctrl2)
        GyroRange250dps  => 8750
        GyroRange500dps  => 17500
        GyroRange1000dps => 35000
        GyroRange2000dps => 70000

// The signed 16-bit count at `i` of `b`, low byte first.
fn s16_at(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend((b[i + 1] as Int << 8) | b[i] as Int, 16)

// The milli-g of the three axes at `i` of `b`, for the step `ug`.
fn accel_at(b: DevBytes, i: Int, ug: Int) -> AccelMilliG
    AccelMilliG { x: s16_at(b, i) * ug / 1000, y: s16_at(b, i + 2) * ug / 1000, z: s16_at(b, i + 4) * ug / 1000 }

// The milli-degrees per second of the three axes at `i` of `b`, for the
// step `udps`.
fn gyro_at(b: DevBytes, i: Int, udps: Int) -> GyroMilliDps
    GyroMilliDps { x: s16_at(b, i) * udps / 1000, y: s16_at(b, i + 2) * udps / 1000, z: s16_at(b, i + 4) * udps / 1000 }

// ── Rates ────────────────────────────────────────────────────────────

// The accelerometer rate in thousandths of a hertz that an ODR_XL code
// selects (Table 44): 0 for power-down and for the codes the part does not
// have.  Code 1011 is 1.6 Hz in low-power mode (`lp`) and 12.5 Hz in
// high-performance mode.
pub fn xl_mhz_of_code(code: Int, lp: Bool) -> Int
    if code == 11
        if lp
            return 1600
        return 12500
    g_mhz_of_code(code)

// The gyroscope rate in thousandths of a hertz that an ODR_G code selects
// (Table 48): 0 for power-down and for the codes the part does not have.
pub fn g_mhz_of_code(code: Int) -> Int
    match code
        1  => 12500
        2  => 26000
        3  => 52000
        4  => 104000
        5  => 208000
        6  => 416000
        7  => 833000
        8  => 1666000
        9  => 3332000
        10 => 6664000
        _  => 0

// The ODR code of the slowest rate at or above `mhz` thousandths of a
// hertz, or of the fastest the part has; 0 (power-down) for a rate of 0 or
// less.  1.6 Hz is code 1011, and only when `lp` says low-power mode.
pub fn odr_code_for(mhz: Int, lp: Bool) -> Int
    if mhz <= 0
        return 0
    if lp and mhz <= 1600
        return 11
    for code in 1..11
        if g_mhz_of_code(code) >= mhz
            return code
    10

// A rate in thousandths of a hertz as whole hertz: to the nearest, 0 for
// power-down.  1.6 Hz reads as 2 and 12.5 Hz as 13.
pub fn hz_of_mhz(mhz: Int) -> Int
    if mhz <= 0
        return 0
    (mhz + 500) / 1000

// ── Samples ──────────────────────────────────────────────────────────

// The most recent acceleration in milli-g: the full scale is read first,
// then the six output registers in one burst.  `None` when the part did not
// answer.
pub fn accel_read_of<P: Lsm6dsoPort>(p: P) -> ?AccelMilliG [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL1_XL, 2, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(OUTX_L_A, 6, var b)
        return None
    Some(accel_at(b, 0, ug_per_count(r[0] as Int)))

// The most recent rate of turn in milli-degrees per second, read the same
// way.
pub fn gyro_read_of<P: Lsm6dsoPort>(p: P) -> ?GyroMilliDps [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL1_XL, 2, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(OUTX_L_G, 6, var b)
        return None
    Some(gyro_at(b, 0, udps_per_count(r[1] as Int)))

// Both from one burst of twelve registers, the gyroscope's first: the two
// are one pair of samples as far as the part's registers go.
pub fn imu_read_of<P: Lsm6dsoPort>(p: P) -> ?ImuSample [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL1_XL, 2, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(OUTX_L_G, 12, var b)
        return None
    Some(ImuSample { accel: accel_at(b, 6, ug_per_count(r[0] as Int)), gyro: gyro_at(b, 0, udps_per_count(r[1] as Int)) })

// Whether a new accelerometer sample has completed since the last read:
// STATUS_REG's XLDA.
pub fn accel_ready_of<P: Lsm6dsoPort>(p: P) -> Bool [hw]
    ((reg_read(p, STATUS_REG) ?? 0) & ST_XLDA) != 0

// The same for the gyroscope: GDA.
pub fn gyro_ready_of<P: Lsm6dsoPort>(p: P) -> Bool [hw]
    ((reg_read(p, STATUS_REG) ?? 0) & ST_GDA) != 0

// The die temperature in milli-degrees Celsius: the 16-bit count at 256
// per degree, 0 at 25 °C (Table 4).  The sensor is refreshed only while a
// motion sensor is on.  `None` when the part did not answer.
pub fn temp_read_of<P: Lsm6dsoPort>(p: P) -> ?TempMilliC [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(OUT_TEMP_L, 2, var b)
        return None
    Some(TempMilliC { milli_c: TEMP_ZERO_MC + s16_at(b, 0) * 1000 / TEMP_COUNTS_PER_C })

// ── Full scale, rate and power mode ──────────────────────────────────

// The accelerometer range, ±2 g when the part does not answer.
pub fn accel_range_read<P: Lsm6dsoPort>(p: P) -> AccelRange [hw]
    accel_range_of(reg_read(p, CTRL1_XL) ?? 0)

// Sets the accelerometer range and leaves the other bits of CTRL1_XL:
// whether the part took it.
pub fn accel_range_write<P: Lsm6dsoPort>(p: P, r: AccelRange) -> Bool [hw]
    reg_update(p, CTRL1_XL, FS_MASK, accel_fs_of(r) << 2)

// The gyroscope range; ±250 dps for ±125 dps, and when the part does not
// answer.
pub fn gyro_range_read<P: Lsm6dsoPort>(p: P) -> GyroRange [hw]
    gyro_range_of(reg_read(p, CTRL2_G) ?? 0)

// Sets the gyroscope range, leaving ±125 dps: whether the part took it.
pub fn gyro_range_write<P: Lsm6dsoPort>(p: P, r: GyroRange) -> Bool [hw]
    reg_update(p, CTRL2_G, FS_MASK | FS_125, gyro_fs_of(r) << 2)

// Sets the gyroscope to ±125 dps, which `GyroRange` has no value for:
// whether the part took it.  The readings are converted at 125 dps.
pub fn gyro_range_write_125<P: Lsm6dsoPort>(p: P) -> Bool [hw]
    reg_update(p, CTRL2_G, FS_125, FS_125)

// The accelerometer rate in thousandths of a hertz, 0 when it is powered
// down, -1 when the part did not answer.  CTRL1_XL and CTRL6_C come in one
// burst, since code 1011 means different rates with XL_HM_MODE set and
// clear.
pub fn accel_rate_read<P: Lsm6dsoPort>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(CTRL1_XL, 6, var b)
        return -1
    xl_mhz_of_code((b[0] as Int) >> 4, ((b[5] as Int) & C6_XL_HM_MODE) != 0)

// Sets the accelerometer to the slowest rate at or above `mhz` and answers
// the rate taken, 0 for a request of 0, which powers the sensor down, and
// -1 when the part did not take it.  The first sample comes one period
// later, and the filters settle for a few more.
pub fn accel_rate_write<P: Lsm6dsoPort>(p: P, mhz: Int) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(CTRL1_XL, 6, var b)
        return -1
    let lp = ((b[5] as Int) & C6_XL_HM_MODE) != 0
    let code = odr_code_for(mhz, lp)
    if not reg_update(p, CTRL1_XL, 0xF0, code << 4)
        return -1
    xl_mhz_of_code(code, lp)

// The gyroscope rate in thousandths of a hertz, 0 when it is powered down,
// -1 when the part did not answer.
pub fn gyro_rate_read<P: Lsm6dsoPort>(p: P) -> Int [hw]
    let Some(v) = reg_read(p, CTRL2_G) else return -1
    g_mhz_of_code(v >> 4)

// Sets the gyroscope to the slowest rate at or above `mhz`, as
// `accel_rate_write` does; the gyroscope has no 1.6 Hz.
pub fn gyro_rate_write<P: Lsm6dsoPort>(p: P, mhz: Int) -> Int [hw]
    let code = odr_code_for(mhz, false)
    if not reg_update(p, CTRL2_G, 0xF0, code << 4)
        return -1
    g_mhz_of_code(code)

// The rate in whole hertz for the traits: the thousandths clamped to 0.
pub fn accel_rate_hz_read<P: Lsm6dsoPort>(p: P) -> Int [hw]
    hz_of_mhz(accel_rate_read(p))

// The rate taken in whole hertz after `hz` was asked for.
pub fn accel_rate_hz_write<P: Lsm6dsoPort>(p: P, hz: Int) -> Int [hw]
    hz_of_mhz(accel_rate_write(p, hz * 1000))

// The gyroscope's rate in whole hertz.
pub fn gyro_rate_hz_read<P: Lsm6dsoPort>(p: P) -> Int [hw]
    hz_of_mhz(gyro_rate_read(p))

// The gyroscope's rate taken in whole hertz after `hz` was asked for.
pub fn gyro_rate_hz_write<P: Lsm6dsoPort>(p: P, hz: Int) -> Int [hw]
    hz_of_mhz(gyro_rate_write(p, hz * 1000))

// The value of XL_HM_MODE or G_HM_MODE for a power mode: 1 for low power.
fn mode_bit(m: Lsm6dsoMode) -> Int
    match m
        Lsm6dsoHighPerf => 0
        Lsm6dsoLowPower => 1

// The accelerometer's power mode, high performance when the part does not
// answer.
pub fn accel_mode_read<P: Lsm6dsoPort>(p: P) -> Lsm6dsoMode [hw]
    if ((reg_read(p, CTRL6_C) ?? 0) & C6_XL_HM_MODE) != 0
        return Lsm6dsoLowPower
    Lsm6dsoHighPerf

// Sets the accelerometer's power mode: whether the part took it.  Low-power
// mode applies at 12.5, 26 and 52 Hz and normal mode at 104 and 208 Hz;
// above them the sensor is in high-performance mode whatever the bit says.
// A rate set as 1011 changes between 1.6 and 12.5 Hz with the bit.
pub fn accel_mode_write<P: Lsm6dsoPort>(p: P, m: Lsm6dsoMode) -> Bool [hw]
    reg_update(p, CTRL6_C, C6_XL_HM_MODE, mode_bit(m) * C6_XL_HM_MODE)

// The gyroscope's power mode.
pub fn gyro_mode_read<P: Lsm6dsoPort>(p: P) -> Lsm6dsoMode [hw]
    if ((reg_read(p, CTRL7_G) ?? 0) & C7_G_HM_MODE) != 0
        return Lsm6dsoLowPower
    Lsm6dsoHighPerf

// Sets the gyroscope's power mode: low power at 12.5, 26 and 52 Hz, normal
// mode at 104 and 208 Hz.
pub fn gyro_mode_write<P: Lsm6dsoPort>(p: P, m: Lsm6dsoMode) -> Bool [hw]
    reg_update(p, CTRL7_G, C7_G_HM_MODE, mode_bit(m) * C7_G_HM_MODE)

// ── Interrupt pins ───────────────────────────────────────────────────

// Sets INT1_CTRL to `mask`, built from the `INT1_` constants: whether the
// part took it.  `start` sets the two data-ready bits.
pub fn int1_route<P: Lsm6dsoPort>(p: P, mask: Int) -> Bool [hw]
    reg_write(p, INT1_CTRL, mask)

// Sets INT2_CTRL to `mask`, built from the `INT2_` constants.
pub fn int2_route<P: Lsm6dsoPort>(p: P, mask: Int) -> Bool [hw]
    reg_write(p, INT2_CTRL, mask)

// Sets the pins' polarity and output type: `active_low` flips both pins,
// `open_drain` makes them open-drain in place of push-pull.  Whether the
// part took it.
pub fn int_pins_config<P: Lsm6dsoPort>(p: P, active_low: Bool, open_drain: Bool) -> Bool [hw]
    var v = 0
    if active_low
        v = v | C3_H_LACTIVE
    if open_drain
        v = v | C3_PP_OD
    reg_update(p, CTRL3_C, C3_H_LACTIVE | C3_PP_OD, v)

// ── The FIFO ─────────────────────────────────────────────────────────
//
// The FIFO is 3 KB of words of a tag byte and six data bytes (§ 6.5).  It
// is off after `start`.  `fifo_start` turns it on in continuous mode,
// which overwrites the oldest word when it is full, with the accelerometer
// batched at its present rate and the gyroscope too when asked.  The words
// arrive in the order the sensors produce them, so with both batched the
// accelerometer's and the gyroscope's alternate and the count that the part
// gives is of words of both kinds.  Compression is off, so the only tags
// are the gyroscope's (1) and the accelerometer's (2).

// The number of words in the FIFO, 0 when it is empty or the part did not
// answer: DIFF_FIFO, ten bits over two registers.
pub fn fifo_count<P: Lsm6dsoPort>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(FIFO_STATUS1, 2, var b)
        return 0
    (b[0] as Int) | (((b[1] as Int) & 3) << 8)

// Turns the FIFO on in continuous mode with the watermark at `threshold`
// words, 1 to 511, and puts the watermark on INT1 in place of the
// data-ready flags: whether the part took every setting.  The accelerometer
// is batched at the rate it runs at and the gyroscope, when `with_gyro`, at
// its rate.
//
// Fix kept: ST's FIFO examples set the FIFO to bypass before they change
// its configuration (§ 6.5.2 and § 6.5.1), and so does this, then write the
// batch rates and the watermark, then the mode last.
pub fn fifo_start<P: Lsm6dsoPort>(p: P, threshold: Int, with_gyro: Bool) -> Bool [hw]
    var th = threshold
    if th < 1
        th = 1
    if th > FIFO_WTM_MAX
        th = FIFO_WTM_MAX
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL1_XL, 2, var r)
        return false
    var gy = 0
    if with_gyro
        gy = (r[1] as Int) >> 4
    if not reg_write(p, FIFO_CTRL4, FIFO_BYPASS)
        return false
    if not reg_write(p, FIFO_CTRL1, th & 0xFF)
        return false
    if not reg_update(p, FIFO_CTRL2, 0x01, th >> 8)
        return false
    if not reg_write(p, FIFO_CTRL3, (gy << 4) | ((r[0] as Int) >> 4))
        return false
    if not reg_update(p, INT1_CTRL, INT1_DRDY_XL | INT1_DRDY_G | INT1_FIFO_TH, INT1_FIFO_TH)
        return false
    reg_write(p, FIFO_CTRL4, FIFO_CONTINUOUS)

// Turns the FIFO off, which empties it, stops the batching and puts the
// data-ready flags back on INT1: whether the part took every setting.
pub fn fifo_stop<P: Lsm6dsoPort>(p: P) -> Bool [hw]
    if not reg_write(p, FIFO_CTRL4, FIFO_BYPASS)
        return false
    if not reg_write(p, FIFO_CTRL3, 0)
        return false
    reg_update(p, INT1_CTRL, INT1_DRDY_XL | INT1_DRDY_G | INT1_FIFO_TH, INT1_DRDY_XL | INT1_DRDY_G)

// Takes one word out of the FIFO into `b`, the tag byte first and the six
// data bytes after it, in one burst: the tag's sensor field, or -1 when the
// part did not answer.  The read of the last data register moves the FIFO
// to the next word.
fn fifo_word<P: Lsm6dsoPort>(p: P, var b: DevBytes) -> Int [hw]
    if not p.read_regs(FIFO_DATA_OUT_TAG, 7, var b)
        return -1
    (b[0] as Int) >> 3

// Moves the accelerometer's words of the FIFO, oldest first, into `dst`,
// which is emptied first, and answers how many words it took out.  A word
// of the gyroscope or of any other kind is taken out and dropped; a
// program that batches both reads with `fifo_read_imu`.  The count is read
// once and the full scale once.
pub fn fifo_read<P: Lsm6dsoPort>(p: P, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
    dst.clear()
    let n = fifo_count(p)
    if n == 0
        return 0
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL1_XL, 2, var r)
        return 0
    let ug = ug_per_count(r[0] as Int)
    var moved = 0
    for _i in 0..n
        if dst.len() >= LIST_DEPTH
            break
        var b: DevBytes = Vec.new()
        let tag = fifo_word(p, var b)
        if tag < 0
            break
        moved = moved + 1
        if tag == TAG_ACCEL
            let _ = dst.push(accel_at(b, 1, ug))
    moved

// Moves the FIFO's words into `accel` and `gyro`, each emptied first, oldest
// first, and answers how many words it took out.  It stops when either list
// is full, so no word is taken out without room.  A word of another kind is
// taken out and dropped.
pub fn fifo_read_imu<P: Lsm6dsoPort>(p: P, var accel: Vec[AccelMilliG; 32],
                                     var gyro: Vec[GyroMilliDps; 32]) -> Int [hw]
    accel.clear()
    gyro.clear()
    let n = fifo_count(p)
    if n == 0
        return 0
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL1_XL, 2, var r)
        return 0
    let ug = ug_per_count(r[0] as Int)
    let udps = udps_per_count(r[1] as Int)
    var moved = 0
    for _i in 0..n
        if accel.len() >= LIST_DEPTH or gyro.len() >= LIST_DEPTH
            break
        var b: DevBytes = Vec.new()
        let tag = fifo_word(p, var b)
        if tag < 0
            break
        moved = moved + 1
        if tag == TAG_ACCEL
            let _ = accel.push(accel_at(b, 1, ug))
        elif tag == TAG_GYRO
            let _ = gyro.push(gyro_at(b, 1, udps))
    moved

// ── Self-test ────────────────────────────────────────────────────────

// Waits for a new-data flag of STATUS_REG by polling it, at most
// `SELF_TEST_POLLS` times: whether it came.
fn wait_status<P: Lsm6dsoPort>(p: P, flag: Int) -> Bool [hw]
    for _i in 0..SELF_TEST_POLLS
        if ((reg_read(p, STATUS_REG) ?? 0) & flag) != 0
            return true
    false

// Lets `skip` samples pass and averages the next `ST_AVERAGE`, in milli-g:
// `None` when a sample did not come.
fn accel_mean<P: Lsm6dsoPort>(p: P, skip: Int) -> ?AccelMilliG [hw]
    var sx = 0
    var sy = 0
    var sz = 0
    for i in 0..(skip + ST_AVERAGE)
        if not wait_status(p, ST_XLDA)
            return None
        let Some(s) = accel_read_of(p) else return None
        if i >= skip
            sx = sx + s.x
            sy = sy + s.y
            sz = sz + s.z
    Some(AccelMilliG { x: sx / ST_AVERAGE, y: sy / ST_AVERAGE, z: sz / ST_AVERAGE })

// The same for the gyroscope, in milli-degrees per second.
fn gyro_mean<P: Lsm6dsoPort>(p: P, skip: Int) -> ?GyroMilliDps [hw]
    var sx = 0
    var sy = 0
    var sz = 0
    for i in 0..(skip + ST_AVERAGE)
        if not wait_status(p, ST_GDA)
            return None
        let Some(s) = gyro_read_of(p) else return None
        if i >= skip
            sx = sx + s.x
            sy = sy + s.y
            sz = sz + s.z
    Some(GyroMilliDps { x: sx / ST_AVERAGE, y: sy / ST_AVERAGE, z: sz / ST_AVERAGE })

// The change the accelerometer's self-test makes to its outputs (Table 2,
// the procedure of ST's `lsm6dso_self_test` example): the sensor at 52 Hz
// and ±4 g with block data update is read with the self-test off and again
// with it on, positive or `negative`, five samples averaged each time after
// the output has settled for 100 ms, and the answer is the second mean
// minus the first, in milli-g.  The settings the sensor had are put back.
// The board must be still.  `None` when the part did not answer or a sample
// did not come.
//
// Table 2 gives the change as 50 to 1700 mg, whatever the full scale;
// `accel_self_test_within` compares a change with those limits.
pub fn accel_self_test<P: Lsm6dsoPort>(p: P, negative: Bool) -> ?AccelMilliG [hw]
    let Some(c1) = reg_read(p, CTRL1_XL) else return None
    var st = C5_ST_XL_POS
    if negative
        st = C5_ST_XL_NEG
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if reg_update(p, CTRL3_C, C3_BDU, C3_BDU) and reg_write(p, CTRL1_XL, XL_ST_CTRL1)
        if let Some(off) = accel_mean(p, XL_ST_SETTLE)
            if reg_update(p, CTRL5_C, C5_ST_XL_MASK, st)
                if let Some(on) = accel_mean(p, XL_ST_SETTLE)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    let _back_st = reg_update(p, CTRL5_C, C5_ST_XL_MASK, 0)
    let _back_c1 = reg_write(p, CTRL1_XL, c1)
    if not ok
        return None
    Some(AccelMilliG { x: dx, y: dy, z: dz })

// The change the gyroscope's self-test makes: the sensor at 208 Hz and
// ±2000 dps, read with the self-test off and on, in milli-degrees per
// second.  Table 2 gives 150 to 700 dps at ±2000 dps.
pub fn gyro_self_test<P: Lsm6dsoPort>(p: P, negative: Bool) -> ?GyroMilliDps [hw]
    let Some(c2) = reg_read(p, CTRL2_G) else return None
    var st = C5_ST_G_POS
    if negative
        st = C5_ST_G_NEG
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if reg_update(p, CTRL3_C, C3_BDU, C3_BDU) and reg_write(p, CTRL2_G, G_ST_CTRL2)
        if let Some(off) = gyro_mean(p, G_ST_SETTLE)
            if reg_update(p, CTRL5_C, C5_ST_G_MASK, st)
                if let Some(on) = gyro_mean(p, G_ST_SETTLE)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    let _back_st = reg_update(p, CTRL5_C, C5_ST_G_MASK, 0)
    let _back_c2 = reg_write(p, CTRL2_G, c2)
    if not ok
        return None
    Some(GyroMilliDps { x: dx, y: dy, z: dz })

// The magnitude of `v`.
fn abs_of(v: Int) -> Int
    if v < 0
        return 0 - v
    v

// Whether every axis of the accelerometer self-test change `d` is 50 to
// 1700 mg in magnitude (Table 2).
pub fn accel_self_test_within(d: AccelMilliG) -> Bool
    abs_of(d.x) >= 50 and abs_of(d.x) <= 1700 and abs_of(d.y) >= 50 and abs_of(d.y) <= 1700 and abs_of(d.z) >= 50 and abs_of(d.z) <= 1700

// Whether every axis of the gyroscope self-test change `d` is 150 to 700
// dps in magnitude (Table 2, at ±2000 dps).
pub fn gyro_self_test_within(d: GyroMilliDps) -> Bool
    abs_of(d.x) >= 150000 and abs_of(d.x) <= 700000 and abs_of(d.y) >= 150000 and abs_of(d.y) <= 700000 and abs_of(d.z) >= 150000 and abs_of(d.z) <= 700000

// ── Bring-up ─────────────────────────────────────────────────────────

// Waits for the software reset to finish: SW_RESET reads 0 again.  A read
// that fails counts as not finished.  Whether it finished within
// `RESET_POLLS` polls.
fn wait_reset<P: Lsm6dsoPort>(p: P) -> Bool [hw]
    for _i in 0..RESET_POLLS
        if ((reg_read(p, CTRL3_C) ?? C3_SW_RESET) & C3_SW_RESET) == 0
            return true
    false

// Brings the part up: the bus made ready; the register bank set to the
// user bank; WHO_AM_I checked; a software reset, which puts the user
// registers back to their defaults, and its end waited for; block data
// update and the address increment on; the I3C block off; on SPI the I2C
// block off; data-ready masked while the filters settle; the full-scale
// mode, XL_HM_MODE and G_HM_MODE at their defaults; both data-ready flags
// on INT1; and both sensors at 104 Hz in high-performance mode, ±2 g and
// ±250 dps.  Answers whether the part answered as an LSM6DSO and took every
// setting.  The caller has waited the 35 ms the part takes to turn on
// (Table 3); the first samples come one period later.
//
// Fixes kept: Zephyr's driver puts the part in the user bank before it
// reads WHO_AM_I and before the reset, since a part left in an embedded-
// function bank answers other registers there (§ 9.1), and so does this;
// ST's examples wait for SW_RESET to clear, and disable I3C after the
// reset, as this does (Zephyr disables it before and notes that the bit
// survives a reset).
pub fn start<P: Lsm6dsoPort>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if not reg_write(p, FUNC_CFG_ACCESS, 0)
        return false
    if reg_read(p, WHO_AM_I) != Some(ID_LSM6DSO)
        return false
    if not p.write_reg(CTRL3_C, C3_SW_RESET)
        return false
    if not wait_reset(p)
        return false
    if not reg_write(p, CTRL3_C, C3_BDU | C3_IF_INC)
        return false
    if not reg_update(p, CTRL9_XL, C9_I3C_DISABLE, C9_I3C_DISABLE)
        return false
    var c4 = C4_DRDY_MASK
    if p.on_spi()
        c4 = c4 | C4_I2C_DISABLE
    if not reg_update(p, CTRL4_C, C4_DRDY_MASK | C4_I2C_DISABLE, c4)
        return false
    if not reg_update(p, CTRL8_XL, C8_XL_FS_MODE, 0)
        return false
    if not reg_update(p, CTRL6_C, C6_XL_HM_MODE, 0)
        return false
    if not reg_update(p, CTRL7_G, C7_G_HM_MODE, 0)
        return false
    if not reg_write(p, INT1_CTRL, INT1_DRDY_XL | INT1_DRDY_G)
        return false
    if not reg_write(p, CTRL2_G, ODR_104 << 4)
        return false
    reg_write(p, CTRL1_XL, ODR_104 << 4)

// ── The part on an I2C bus ───────────────────────────────────────────

// An LSM6DSO on a board's I2C bus at the address `w.addr`, 0x6A or 0x6B,
// with the board's GPIO for the INT1 line.
pub @value
struct Lsm6dso
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl Lsm6dsoPort for Lsm6dso
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

    fn on_spi(self) -> Bool [hw]
        false

impl Lsm6dso
    // The part at `w.addr` on the board's I2C bus, as a board's device
    // table builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Lsm6dso
        Lsm6dso { bus: bus, pins: pins, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // The gyroscope's rate, in thousandths of a hertz and in whole hertz,
    // and its setters.
    fn gyro_set_rate_hz(self, hz: Int) -> Int [hw]
        gyro_rate_hz_write(self, hz)

    fn accel_rate_mhz(self) -> Int [hw]
        accel_rate_read(self)

    fn set_accel_rate_mhz(self, mhz: Int) -> Int [hw]
        accel_rate_write(self, mhz)

    fn gyro_rate_mhz(self) -> Int [hw]
        gyro_rate_read(self)

    fn set_gyro_rate_mhz(self, mhz: Int) -> Int [hw]
        gyro_rate_write(self, mhz)

    // The gyroscope at ±125 dps.
    fn gyro_set_125dps(self) -> Bool [hw]
        gyro_range_write_125(self)

    // The power modes of the two sensors.
    fn accel_mode(self) -> Lsm6dsoMode [hw]
        accel_mode_read(self)

    fn set_accel_mode(self, m: Lsm6dsoMode) -> Bool [hw]
        accel_mode_write(self, m)

    fn gyro_mode(self) -> Lsm6dsoMode [hw]
        gyro_mode_read(self)

    fn set_gyro_mode(self, m: Lsm6dsoMode) -> Bool [hw]
        gyro_mode_write(self, m)

    // The interrupt pins.
    fn route_int1(self, mask: Int) -> Bool [hw]
